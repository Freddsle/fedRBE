# FeatureCloud related files
# Controller run directories live with evaluation inputs; source tests are tracked.
/evaluation_data/**/tests/
**/logs/
/evaluation_data/**/workflows/
**/testbed-*/
**/site_info.json
**/individual_results/**
!**/individual_results/
!**/individual_results/*/

# to many files
evaluation/eval_simulation/*/lmvp/*.tsv
evaluation_data/simulated/*/after/runs/*.tsv
evaluation_data/simulated/*/before/intermediate/*.tsv
!evaluation_data/simulated/*/before/intermediate/1_intensities_data.tsv
evaluation/eval_simulation/lmpv_plots/*.pdf
/evaluation/eval_simulation/pca_plots/

# Classification evaluation: generated config files
evaluation_data/**/config_forest.yaml

# anything with tmp in the name is meant to be temporary
**/tmp*

# Allow specific files to be used in git lfs
## Allow all federated corrected data
!evaluation_data/**/after/individual_results/*/full_corrected_data.csv
!evaluation_data/**/after/individual_results/*/only_batch_corrected_data.csv
!evaluation_data/**/after/individual_results/*/report.txt
!evaluation_data/**/after/*/individual_results/*/full_corrected_data.csv
!evaluation_data/**/after/*/individual_results/*/only_batch_corrected_data.csv
!evaluation_data/quartet_multiomics/after/*/*/individual_results/*/full_corrected_data.csv
!evaluation_data/quartet_multiomics/after/*/*/individual_results/*/only_batch_corrected_data.csv
!evaluation_data/**/after/*/individual_results/*/report.txt

## Also the centrally corrected data
!evaluation_data/**/after/intensities_R_corrected.tsv
!evaluation_data/**/after/*/intensities_R_corrected.tsv


# Intermediate files generated by the clustering evaluation
# Retain assignment and metrics tables; execution exports stay local.
/evaluation_clusterization_after_correction/real_datasets/**/fc_kmeans_res/
/evaluation_clusterization_after_correction/real_datasets/**/inputs/
/evaluation_clusterization_after_correction/real_datasets/**/kmeans_res/
# Regenerable per-fit details; selected analysis summaries remain tracked.
/evaluation_clusterization_after_correction/real_datasets/panel5000/analysis/arrival-order/arrival_orders.tsv
/evaluation_clusterization_after_correction/real_datasets/panel5000/analysis/starts/individual_starts.tsv
/evaluation_clusterization_after_correction/real_datasets/panel5000/analysis/sensitivity/sensitivity.tsv
/evaluation_clusterization_after_correction/real_datasets/panel5000/analysis/subsample/subsample_paired_deltas.tsv
/evaluation_clusterization_after_correction/real_datasets/panel5000/analysis/subsample/subsample_seed_medians.tsv
# RF panels are reproducible subsets of canonical inputs.
/evaluation_data/*/panel5000/

# ccRCC raw acquisition files and intermediate reports remain local.
evaluation_data/ccRCC_studies/data/

